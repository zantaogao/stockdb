{
  "1": {
    "class_type": "LoadImage",
    "_meta": {"title": "输入图片"},
    "inputs": {"image": "input.png"}
  },
  "2": {
    "class_type": "CLIPVisionLoader",
    "_meta": {"title": "CLIP视觉模型"},
    "inputs": {"clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"}
  },
  "3": {
    "class_type": "WanVideoVAELoader",
    "_meta": {"title": "VAE加载"},
    "inputs": {
      "model_name": "Wan2.1_VAE.pth",
      "precision": "bf16"
    }
  },
  "4": {
    "class_type": "WanVideoClipVisionEncode",
    "_meta": {"title": "图片编码"},
    "inputs": {
      "clip_vision": ["2", 0],
      "image_1": ["1", 0],
      "strength_1": 1.0,
      "strength_2": 0.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": false
    }
  },
  "5": {
    "class_type": "LoadWanVideoT5TextEncoder",
    "_meta": {"title": "T5文本编码器"},
    "inputs": {
      "model_name": "models_t5_umt5-xxl-enc-bf16.pth",
      "precision": "bf16",
      "offload_device": "offload_device",
      "use_fp8_t5": "disabled"
    }
  },
  "6": {
    "class_type": "WanVideoTextEncode",
    "_meta": {"title": "文字编码"},
    "inputs": {
      "t5": ["5", 0],
      "positive_prompt": "dancing, gentle dance, swaying gracefully, moving, character animation, anime dance, flowing dress and ribbons, 2D animation",
      "negative_prompt": "static, still, frozen, no motion, blurry, distorted, bad quality",
      "force_offload": false,
      "device": "gpu"
    }
  },
  "7": {
    "class_type": "WanVideoModelLoader",
    "_meta": {"title": "I2V模型"},
    "inputs": {
      "model": "Wan2_1-I2V-14B-720P_bf16.safetensors",
      "base_precision": "bf16",
      "quantization": "disabled",
      "load_device": "main_device",
      "attention_mode": "sdpa"
    }
  },
  "8": {
    "class_type": "WanVideoImageToVideoEncode",
    "_meta": {"title": "图生视频编码"},
    "inputs": {
      "vae": ["3", 0],
      "clip_embeds": ["4", 0],
      "width": 832,
      "height": 480,
      "num_frames": 80,
      "noise_aug_strength": 0.0,
      "start_latent_strength": 1.0,
      "end_latent_strength": 1.0,
      "force_offload": false
    }
  },
  "9": {
    "class_type": "WanVideoSampler",
    "_meta": {"title": "采样器"},
    "inputs": {
      "model": ["7", 0],
      "image_embeds": ["8", 0],
      "text_embeds": ["6", 0],
      "steps": 20,
      "cfg": 5.0,
      "shift": 5.0,
      "seed": 42,
      "force_offload": false,
      "scheduler": "dpm++_sde",
      "riflex_freq_index": 0,
      "rope_function": "comfy"
    }
  },
  "10": {
    "class_type": "WanVideoDecode",
    "_meta": {"title": "解码"},
    "inputs": {
      "vae": ["3", 0],
      "samples": ["9", 0],
      "enable_vae_tiling": false,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    }
  },
  "11": {
    "class_type": "VHS_VideoCombine",
    "_meta": {"title": "视频合成"},
    "inputs": {
      "images": ["10", 0],
      "frame_rate": 16,
      "loop_count": 0,
      "filename_prefix": "wan_i2v",
      "format": "video/h264-mp4",
      "pingpong": false,
      "save_output": true,
      "trigger_on_load": true
    }
  }
}
